{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["buyer", "seller", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Shop": {
      "title": "Shop",
      "description": "Seller's shop information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "logo": { "type": "string", "format": "uri" },
        "rating": { "type": "number" },
        "followers": { "type": "integer" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "name"]
    },
    "Product": {
      "title": "Product",
      "description": "Product information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "stock": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "shopId", "name", "price"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Chat session between buyer and seller",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participants"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual message in a chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderUid": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "chatId", "senderUid", "text"]
    },
    "Story": {
      "title": "Story",
      "description": "Short-lived video content (24h)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "videoUrl": { "type": "string" },
        "price": { "type": "string" },
        "isLive": { "type": "boolean" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "shopId", "videoUrl"]
    },
    "Like": {
      "title": "Like",
      "description": "User like on a post",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "postId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "postId"]
    },
    "SavedItem": {
      "title": "SavedItem",
      "description": "User saved post",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "postId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "postId"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "User subscription to a shop",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "sellerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "sellerId"]
    },
    "Obraz": {
      "title": "Obraz",
      "description": "User created outfit (obraz)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sellerId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "posts": { "type": "array", "items": { "$ref": "Product" } },
        "totalPrice": { "type": "string" },
        "type": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "sellerId", "ownerUid", "title"]
    },
    "TelegramLink": {
      "title": "TelegramLink",
      "description": "Stored Telegram forward links with metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "productName": { "type": "string" },
        "price": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "channelName": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "sellerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "processed", "error"] }
      },
      "required": ["id", "url"]
    }
  },
  "firestore": {
    "/users/{uid}": { "schema": "User", "description": "User profiles" },
    "/shops/{shopId}": { "schema": "Shop", "description": "Shop profiles" },
    "/products/{productId}": { "schema": "Product", "description": "Products" },
    "/stories/{storyId}": { "schema": "Story", "description": "Stories" },
    "/likes/{likeId}": { "schema": "Like", "description": "Likes" },
    "/saved_items/{saveId}": { "schema": "SavedItem", "description": "Saved items" },
    "/subscriptions/{subId}": { "schema": "Subscription", "description": "User subscriptions" },
    "/obrazlar/{obrazId}": { "schema": "Obraz", "description": "User outfits" },
    "/chats/{chatId}": { "schema": "Chat", "description": "Chat sessions" },
    "/chats/{chatId}/messages/{messageId}": { "schema": "Message", "description": "Messages" },
    "/telegram_links/{linkId}": { "schema": "TelegramLink", "description": "Telegram links database" }
  }
}
