rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isShopOwner(shopId) {
      return isSignedIn() &&
             get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Shop Rules
    match /shops/{shopId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Post Rules
    match /posts/{postId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /comments/{commentId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // Story Rules
    match /stories/{storyId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Chat Rules
    match /chats/{chatId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // Likes, Saves, Subscriptions
    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /saved_items/{saveId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /subscriptions/{subId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Telegram Links
    match /telegram_links/{linkId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Stats
    match /stats/{statId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Test collection
    match /test/connection {
      allow read: if true;
    }
  }
}
